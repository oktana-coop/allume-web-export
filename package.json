{
  "name": "allume-web-export",
  "private": true,
  "description": "Development tools for allume-web-export: the viewer's build and the end-to-end tests",
  "type": "module",
  "scripts": {
    "build:viewer": "node viewer/build.ts",
    "typecheck": "tsc && tsc -p viewer",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --headed --debug",
    "test:e2e:report": "playwright show-report e2e-results/html",
    "format": "prettier --write viewer e2e playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
